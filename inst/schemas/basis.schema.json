{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuroarchive.org/schemas/lna/2.0/basis.schema.json",
  "title": "Parameters for 'basis' transform",
  "type": "object",
  "properties": {
    "type": { "const": "basis" },
    "version": { "type": "string" },
    "inputs": { "oneOf": [ { "type": "array" }, { "type": "string" } ] },
    "outputs": { "oneOf": [ { "type": "array" }, { "type": "string" } ] },
    "datasets": { "type": "array" },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "method": { "type": "string", "enum": ["pca"], "default": "pca" },
            "k": { "type": "integer", "minimum": 1, "default": 20 },
            "center": { "type": "boolean", "default": true },
            "scale": { "type": "boolean", "default": false },
            "solver_params": { "type": "object", "default": {} },
            "storage_order": {
              "type": "string",
              "enum": ["component_x_voxel", "voxel_x_component"],
              "default": "component_x_voxel"
            }
          },
          "additionalProperties": false
        },
        { "type": "array", "maxItems": 0 }
      ]
    }
  },
  "additionalProperties": true
}
