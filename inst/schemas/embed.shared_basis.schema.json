{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuroarchive.org/schemas/lna/2.0/embed.shared_basis.schema.json",
  "title": "Parameters for 'embed.shared_basis' transform",
  "type": "object",
  "properties": {
    "type": { "const": "embed.shared_basis" },
    "version": { "type": "string" },
    "inputs": { "oneOf": [ { "type": "array" }, { "type": "string" } ] },
    "outputs": { "oneOf": [ { "type": "array" }, { "type": "string" } ] },
    "datasets": { "type": "array" },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "basis_id": { "type": "string" },
            "basis_checksum": { "type": "string" },
            "basis_kind": { "type": "string", "default": "" },
            "basis_locator": { "type": ["string", "null"], "default": null },
            "center": { "type": "boolean", "default": true }
          },
          "required": ["basis_id", "basis_checksum"],
          "additionalProperties": false
        },
        { "type": "array", "maxItems": 0 }
      ]
    }
  },
  "additionalProperties": true
}
