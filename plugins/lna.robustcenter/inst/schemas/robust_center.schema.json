{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuroarchive.org/schemas/lna/2.0/robust_center.schema.json",
  "title": "Parameters for 'robust_center' transform",
  "type": "object",
  "properties": {
    "type": {"type": "string"},
    "version": {"type": "string"},
    "inputs": {"oneOf": [{"type": "array"}, {"type": "string"}]},
    "outputs": {"oneOf": [{"type": "array"}, {"type": "string"}]},
    "datasets": {"type": "array"},
    "params": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["median", "mean"],
          "default": "median",
          "description": "Centering method per column"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
